<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Findhobbies"
        tools:targetApi="31">
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />
        <!-- Activité d'accueil / lancement -->
        <activity
            android:name=".ui.FirstActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Messagerie -->
        <activity
            android:name=".ui.ConversationListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ConversationActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MessageActivity"
            android:exported="false" /> <!-- Amis -->
        <activity
            android:name=".ui.FriendsActivity"
            android:exported="false" /> <!-- Événements -->
        <activity
            android:name=".ui.SuggestedNearEventsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SuggestedEventsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CalendarActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ReservationsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ListEventRegistrationsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.EventRegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.EventDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.EventSearchActivity"
            android:exported="false" /> <!-- Localisation -->
        <activity
            android:name=".ui.LocationActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MapActivity"
            android:exported="false">
            <meta-data
                android:name="com.google.android.geo.API_KEY"
                android:value="TA_CLE_GOOGLE_MAPS_ICI" />
        </activity>
        <activity
            android:name=".ui.UserLocationActivity"
            android:exported="true" /> <!-- Authentification -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false" /> <!-- Profil & hobbies -->
        <activity
            android:name=".ui.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.HobbyActivity"
            android:exported="false" /> <!-- MainActivity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />
    </application>

</manifest>
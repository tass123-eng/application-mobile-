<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="48dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_empty_calendar"

        app:tint="@color/gray_300"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aucune réservation"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/gray_700"
        android:layout_marginTop="24dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vous n'avez pas encore de réservations. Explorez les événements disponibles !"
        android:textSize="14sp"
        android:textColor="@color/gray_500"
        android:layout_marginTop="8dp"
        android:textAlignment="center"
        />

    <Button
        android:id="@+id/btnExploreEvents"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Explorer les événements"
        android:textColor="@color/white"
        android:paddingHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/button_primary"
        />
</LinearLayout>